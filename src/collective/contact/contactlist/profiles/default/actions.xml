<?xml version="1.0" encoding="utf-8"?>
<object xmlns:i18n="http://xml.zope.org/namespaces/i18n"
        meta_type="Plone Actions Tool"
        name="portal_actions"
>
  <object meta_type="CMF Action Category"
          name="object_buttons"
  >
    <object meta_type="CMF Action"
            name="contactlist-addtolist"
            i18n:domain="collective.contact.contactlist"
    >
      <property name="title"
                i18n:translate=""
      >Add to list</property>
      <property name="description"
                i18n:translate=""
      >Add the contact to a contact list</property>
      <property name="url_expr">python:portal_url + '/@@contactlist.add-to-list?form.widgets.contacts:list='+'/'.join(object.getPhysicalPath())+'&amp;ajax_load=1'</property>
      <property name="link_target" />
      <property name="icon_expr" />
      <property name="available_expr">context/@@contactlist.can-add-to-list</property>
      <property name="permissions" />
      <property name="visible">True</property>
      <property name="modal"
                type="text"
      >{"actionOptions": {"displayInModal": false}}</property>
    </object>
  </object>
  <object meta_type="CMF Action Category"
          name="user"
  >
    <object meta_type="CMF Action"
            name="contact-contactlist-mylists"
            i18n:domain="collective.contact.contactlist"
    >
      <property name="title"
                i18n:translate=""
      >My contact lists</property>
      <property name="description"
                i18n:translate=""
      />
      <property name="url_expr">context/@@contactlist.mylists-url</property>
      <property name="link_target" />
      <property name="icon_expr" />
      <property name="available_expr">context/@@contactlist.mylists-url</property>
      <property name="permissions" />
      <property name="visible">True</property>
    </object>
  </object>
</object>
