<?xml version="1.0" encoding="utf-8"?>
<registry>

  <!-- only used at click time (contactfacetednav, Faceted, plone-modal): no dependency on eea.facetednavigation's
       bundles, which may not be installed (a missing dependency drops the bundle) -->
  <records interface="plone.base.interfaces.IBundleRegistry"
           prefix="plone.bundles/collective-contact-contactlist"
  >
    <value key="enabled">True</value>
    <value key="csscompilation" />
    <value key="jscompilation">++resource++collective.contact.contactlist/javascript.js</value>
    <value key="depends">plone</value>
    <value key="load_async">False</value>
    <value key="load_defer">True</value>
  </records>

  <record name="plone.icon.contenttype/contact_list">
    <field type="plone.registry.field.TextLine">
      <title>Contact list</title>
    </field>
    <value key="resource">++plone++bootstrap-icons/person-lines-fill.svg</value>
  </record>

  <!-- lists are stored in member folders -->
  <record name="plone.enable_user_folders">
    <value>True</value>
  </record>

</registry>
